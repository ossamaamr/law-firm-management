# MERSAD local/staging configuration template. Never commit real secrets.
NODE_ENV=development
PORT=3000
PUBLIC_APP_ORIGIN=http://localhost:3000

# Authentication and application secrets
VITE_APP_ID=
JWT_SECRET=
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=
OWNER_OPEN_ID=
OWNER_NAME=

# Database is required for real integration tests; do not use a production URL locally.
DATABASE_URL=

# Approved server-side integrations
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Public contact configuration. Leave unset rather than committing personal data.
PUBLIC_CONTACT_EMAIL=
PUBLIC_SUPPORT_EMAIL=
PUBLIC_SALES_EMAIL=
PUBLIC_BILLING_EMAIL=
PUBLIC_TECHNICAL_EMAIL=
PUBLIC_SECURITY_EMAIL=
PUBLIC_NEWSLETTER_EMAIL=
PUBLIC_FEEDBACK_EMAIL=
PUBLIC_BUG_REPORT_EMAIL=
PUBLIC_CONTACT_PHONE=
PUBLIC_CONTACT_ADDRESS=
PUBLIC_SUPPORT_HOURS=
PUBLIC_SUPPORT_SLACK=
PUBLIC_OFFICE_NAME=
PUBLIC_OFFICE_COUNTRY=SA
PUBLIC_OFFICE_CITY=
PUBLIC_COMPANY_LEGAL_NAME=
PUBLIC_COMPANY_DESCRIPTION=
PUBLIC_COMPANY_LOGO_URL=
PUBLIC_EMERGENCY_EMAIL=
PUBLIC_EMERGENCY_PHONE=
PUBLIC_EMERGENCY_WHATSAPP=
PUBLIC_SECURITY_PGP_URL=
PUBLIC_LINKEDIN_URL=
PUBLIC_TWITTER_URL=
PUBLIC_FACEBOOK_URL=
PUBLIC_INSTAGRAM_URL=
PUBLIC_YOUTUBE_URL=

# Optional analytics: only HTTPS endpoints are accepted by the client.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
